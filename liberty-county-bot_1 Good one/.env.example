DISCORD_TOKEN=your-bot-token-here

# 32-byte hex key used to encrypt secrets at rest (currently the ER:LC
# server key). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Comma-separated Discord server (guild) IDs this bot is allowed to run in.
# Any server NOT in this list gets left automatically -- on join, and again
# on every startup (so removing an ID here kicks the bot out of that server
# next restart too). Leave empty/unset during initial testing if you want,
# but set this before inviting the bot anywhere public.
# Example: ALLOWED_GUILD_IDS=123456789012345678,987654321098765432
ALLOWED_GUILD_IDS=

# Local port the HTTP server (health check + ER:LC event webhooks) listens
# on. On Render (or most PaaS hosts) this is ignored in favor of the PORT
# variable the platform injects automatically -- you don't need to set
# either one there. Only used for local/manual hosting.
WEBHOOK_PORT=8787

# Public HTTPS base URL that reaches the port above (your Render URL, or a
# tunnel for local dev). Used to build the per-guild ER:LC webhook URL shown
# in /config -> In-Game Integration. Example: https://your-app.onrender.com
PUBLIC_WEBHOOK_BASE_URL=
